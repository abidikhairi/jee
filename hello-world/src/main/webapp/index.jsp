<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%
    String name = request.getParameter("name");
    if (name == null || name.isBlank()) {
        name = "World";
    }

    int x = 25;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hello World Jakarta EE 11</title>
</head>
<body style="font-family: sans-serif; margin: 3rem;">
    <h1>Hello, <%= name %>!</h1>
    <p>Value of x: <%= x %> </p>
    <p>This page was generated by a <strong>JSP (Jakarta Pages)</strong>.</p>
    <p>Rendered at <%= new java.util.Date() %></p>
    <p><a href="hello?name=<%= name %>">
        Call the Servlet instead &rarr;</a></p>
</body>
</html>
